{
  "manifest_version": 3,
  "name": "Chudin Note for YouTube",
  "version": "0.1.0",
  "description": "Ghi chú theo timestamp khi xem YouTube, đọc và tìm lại theo cuốn sổ. Dữ liệu chỉ lưu trên máy.",
  "minimum_chrome_version": "116",
  "host_permissions": ["https://www.youtube.com/*"],
  "action": { "default_title": "Mở ghi chú YouTube" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sidepanel.html",
        "sidepanel.js",
        "assets/*.js",
        "assets/*.css"
      ],
      "matches": ["https://www.youtube.com/*"]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
